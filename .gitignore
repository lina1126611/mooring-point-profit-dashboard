.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 실데이터·DB는 저장소에 넣지 않는다
db/*.db
data/raw/*
!data/raw/.gitkeep

# 씨웨이테크에서 수령한 원본 실데이터 (2026-08-03)
씨웨이테크 진짜 데이터/

# 멘토링 전사문·현황정리 — 회사명·팀원 실명·대외비 내용 포함
피드백/

# 가명화 파이프라인 산출물
#   data/local/  = 원본 그대로의 검토표 + 가명 매핑표. 이게 새면 가명화가 무의미하다.
#   data/pseudo/ = 가명화 데이터. 이름은 가려졌지만 실제 금액이 들어 있어
#                  공개 저장소에는 넣지 않는다. 공유는 사람이 직접 한다.
#
# 2026-08-04: 실데이터를 저장소 폴더 **밖**으로 옮겼다(src/paths.py). 위 경로들은
# 이제 비어 있지만 제외 규칙은 남긴다 — 누가 다시 여기에 두면 막아야 하고,
# pre-commit 훅의 검사 대상도 이 경로들이다.
data/local/
data/pseudo/

# 실데이터 위치 설정. 사람마다 경로가 다르고 경로에 사용자명이 들어간다.
# 양식은 paths.local.example.json 을 참고한다.
paths.local.json

# 검산 리포트는 생성물 (scripts/verify_by_hand.py)
reports/

.streamlit/secrets.toml
